{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "numFound",
    "start",
    "num_found",
    "docs"
  ],
  "properties": {
    "numFound": {
      "type": "integer",
      "minimum": 0
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "num_found": {
      "type": "integer",
      "minimum": 0
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string"
          },
          "author_name": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_publish_year": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}